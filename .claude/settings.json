{
  "agent": {
    "planning_mode": true,
    "require_plan_approval": true,
    "prompt_on_decision": true,
    "prompt_on_ambiguity": true
  },
  "session_start": {
    "verify_env_vars": true,
    "read_claude_md": true,
    "read_agents_md": true,
    "confirm_build_status": true
  },
  "quality": {
    "require_tests": true,
    "require_simulator_build": true,
    "enforce_design_system": true,
    "no_spinners": true,
    "no_blank_empty_states": true,
    "no_hardcoded_values": true
