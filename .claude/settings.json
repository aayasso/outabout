    "behavioral_events_required": true,
    "all_jsonb_fields_required": true,
    "coordinate_bucketing_required": true,
    "never_store_precise_coordinates": true
  },
  "professionalism": {
    "no_personal_info_in_output": true,
    "no_developer_names_in_comments": true,
    "no_internal_references_in_ui": true,
    "no_placeholder_copy_in_production": true,
    "user_friendly_errors_only": true
  },
  "skills": [
    "frontend-design",
    "supabase",
    "supabase-postgres-best-practices",
    "security-guidance",
    "Skill Development",
    "Agent Development",
    "find-skills"
