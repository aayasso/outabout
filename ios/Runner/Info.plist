<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OutAbout</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>OutAbout</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- The home-screen widget's deep link. `outabout://schedule` is the only
	     URL this app answers; the widget sets it via widgetURL and
	     WidgetLaunchCoordinator turns it back into a route. Without this key
	     the tap opens the app at whatever screen it was last on, which reads
	     as the widget doing nothing. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.outabout.outabout.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>outabout</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>OutAbout adds an activity to your calendar when you ask it to. It never reads your calendar.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>OutAbout adds an activity to your calendar when you ask it to.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>OutAbout adds an activity to your calendar when you ask it to. It never reads your calendar.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>OutAbout uses your location to show weather conditions and activities near you.</string>
	<!-- Coordinates are bucketed to two decimal places (~1 mile) before they
	     leave the device, so the full-precision prompt asks for accuracy the
	     app never uses. This also keeps the ask consistent with the
	     CoarseLocation declaration in PrivacyInfo.xcprivacy. -->
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
</dict>
</plist>
